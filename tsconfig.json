{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~*": ["./src/webview/*"],
      "webextension-polyfill": ["./src/webview/platform/browser-shim"]
    }
  },
  "include": ["src/webview", "src/shared", "src/config", "global.d.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
